# --- Database (required) ---
# Postgres connection string (e.g. Neon). All app state persists here.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- 0G Compute inference ---
# Inference is paid by each signed-in user's custodial 0G wallet (no shared key).
# Users deposit 0G into their wallet address (shown in the account menu).
# Initial amount deposited into a user's ledger on first use (in 0G).
# Protocol minimum to create a ledger is 3 0G — keep this >= 3.
OG_LEDGER_DEPOSIT=3

# --- Wallet connect (optional) ---
# WalletConnect Cloud projectId for RainbowKit (https://cloud.walletconnect.com).
# Injected wallets (MetaMask, Rainbow) work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Google sign-in + custodial wallet (required for Google login) ---
# Google OAuth Client ID (Google Cloud Console → Credentials → OAuth client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Session cookie signing key — 32 random bytes, base64.  openssl rand -base64 32
SESSION_SECRET=
# Encrypts custodial wallet private keys at rest — 32 bytes, base64. KEEP SECRET.
AES_MASTER_KEY=

# --- MCP (optional) ---
# Public URL of the Mirrl MCP server users paste into Claude/Cursor.
NEXT_PUBLIC_MCP_URL=https://mcp.mirrl.app/mcp

# --- On-chain ownership registry (0G Chain) ---
# Deployed MirrlMemory contract address.
NEXT_PUBLIC_MIRRL_REGISTRY=

# --- Test-token faucet (optional) ---
# Funded pool wallet that dispenses test 0G to signed-in users.
POOL_PRIVATE_KEY=
NEXT_PUBLIC_FAUCET_AMOUNT=5
