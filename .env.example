# --- Database (required) ---
# Postgres connection string (e.g. Neon). All app state persists here.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- 0G Compute inference (optional) ---
# Set to run LIVE inference instead of demo mode.
# Fund a wallet with testnet 0G from https://faucet.0g.ai
OG_PRIVATE_KEY=

# --- Wallet connect (optional) ---
# WalletConnect Cloud projectId for RainbowKit (https://cloud.walletconnect.com).
# Injected wallets (MetaMask, Rainbow) work without it.
NEXT_PUBLIC_WC_PROJECT_ID=
